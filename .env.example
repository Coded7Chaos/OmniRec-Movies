# Copiá este archivo a `.env` (`cp .env.example .env`) y ajustá lo que necesites.
# Todo es opcional: con valores por defecto, `docker compose up` ya funciona.

# --- Capa RAG generativa (opcional) ------------------------------------------
# Clave de Anthropic para que la búsqueda redacte una recomendación con un LLM.
# Si se deja vacía, se usa el fallback determinista por plantilla (la demo
# funciona igual, sin red).
ANTHROPIC_API_KEY=

# --- Puertos del host (cambialos si están ocupados) --------------------------
BACKEND_PORT=8000
WEB_PORT=3000
MLFLOW_PORT=5000
JUPYTER_PORT=8888

# --- URL del API que usa el navegador ----------------------------------------
# Se hornea en el frontend al construirlo (NEXT_PUBLIC_*). Si cambiás esto,
# reconstruí la web: `docker compose build web`.
NEXT_PUBLIC_API_URL=http://localhost:8000
