data/intermediate/ratings_prepared_60pct.parquet
data/intermediate/genome_scores_knn_10pct.parquet
data/intermediate/genome_scores_sample.parquet
data/intermediate/ratings_sample_5pct.parquet
data/intermediate/movies_sample.parquet
data/intermediate/movies_knn_10pct.parquet
data/intermediate/descriptors.parquet
data/*.zip
data/*.zip.md5

